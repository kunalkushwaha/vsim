  "beats": [
    {
      "id": "b1",
      "start": 0,
      "end": 6,
      "caption": "Every website starts as a request that has to travel somewhere - the question is how far.",
      "actions": [
        {
          "target": "t1",
          "do": "reveal",
          "at": 0,
          "dur": 1.5
        },
        {
          "target": "browser1",
          "do": "fadeIn",
          "at": 2,
          "dur": 1
        },
        {
          "target": "t1",
          "do": "fadeOut",
          "at": 4.5,
          "dur": 1
        }
      ]
    },
    {
      "id": "b2",
      "start": 6,
      "end": 15,
      "caption": "Without a CDN, every request makes a long round trip to one distant origin server.",
      "actions": [
        {
          "target": "origin",
          "do": "fadeIn",
          "at": 0,
          "dur": 0.5
        },
        {
          "target": "conn_direct",
          "do": "fadeIn",
          "at": 0.3,
          "dur": 0.5
        },
        {
          "target": "pkt_direct_req",
          "do": "flow",
          "at": 1,
          "dur": 3.5,
          "value": 1
        },
        {
          "target": "origin",
          "do": "state",
          "at": 4.5,
          "dur": 0.5,
          "value": "busy"
        },
        {
          "target": "pkt_direct_res",
          "do": "flow",
          "at": 5,
          "dur": 3.5,
          "value": 1
        }
      ]
    },
    {
      "id": "b3",
      "start": 15,
      "end": 24,
      "caption": "A CDN places edge servers around the globe, ready to hold cached copies close to every visitor.",
      "actions": [
        {
          "target": "cdncloud",
          "do": "fadeIn",
          "at": 0,
          "dur": 1
        },
        {
          "target": "edge1",
          "do": "fadeIn",
          "at": 0.5,
          "dur": 0.5
        },
        {
          "target": "edge2",
          "do": "fadeIn",
          "at": 0.7,
          "dur": 0.5
        },
        {
          "target": "edge3",
          "do": "fadeIn",
          "at": 0.9,
          "dur": 0.5
        },
        {
          "target": "conn_o_e2",
          "do": "fadeIn",
          "at": 1.5,
          "dur": 0.5
        }
      ]
    },
    {
      "id": "b4",
      "start": 24,
      "end": 32,
      "caption": "The origin pushes fresh copies of the site out to every edge location before anyone even asks.",
      "actions": [
        {
          "target": "origindb",
          "do": "fadeIn",
          "at": 0,
          "dur": 0.5
        },
        {
          "target": "pkt_pop2",
          "do": "flow",
          "at": 0.5,
          "dur": 2.5,
          "value": 1
        },
        {
          "target": "origindb",
          "do": "flash",
          "at": 1.5,
          "dur": 1,
          "value": 1
        },
        {
          "target": "conn_o_db",
          "do": "fadeIn",
          "at": 0.3,
          "dur": 0.3
        },
        {
          "target": "cal_cache",
          "do": "pop",
          "at": 4,
          "dur": 0.5
        }
      ]
    },
    {
      "id": "b5",
      "start": 32,
      "end": 41,
      "caption": "When the nearest edge already holds the page, it answers directly - no long trip to the origin needed.",
      "actions": [
        {
          "target": "conn_b_e1",
          "do": "fadeIn",
          "at": 0,
          "dur": 0.5
        },
        {
          "target": "pkt_hit_req",
          "do": "flow",
          "at": 1,
          "dur": 1.2,
          "value": 1
        },
        {
          "target": "edge1",
          "do": "state",
          "at": 2.2,
          "dur": 0.5,
          "value": "ok"
        },
        {
          "target": "pkt_hit_res",
          "do": "flow",
          "at": 2.5,
          "dur": 1.2,
          "value": 1
        },
        {
          "target": "cal_fast",
          "do": "pop",
          "at": 4,
          "dur": 0.5
        }
      ]
    },
    {
      "id": "b6",
      "start": 41,
      "end": 48,
      "caption": "The result: a CDN turns one long journey into many short ones, so the web feels instant everywhere.",
      "actions": [
        {
          "target": "lat_chart",
          "do": "fadeIn",
          "at": 0,
          "dur": 1
        },
        {
          "target": "lat_chart",
          "do": "grow",
          "at": 0.5,
          "dur": 2
        },
        {
          "target": "cal_summary",
          "do": "pop",
          "at": 1.5,
          "dur": 0.5
        },
        {
          "target": "pkt_hit_req",
          "do": "flow",
          "at": 3,
          "dur": 2,
          "value": 2
        },
        {
          "target": "pkt_pop2",
          "do": "flow",
          "at": 3,
          "dur": 2,
          "value": 2
        }
      ]
    }
  ],
